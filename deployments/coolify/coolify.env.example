# Environment Variables to set in Coolify Dashboard:
# 1. DATABASE_URL from your Supabase instance hosted in Coolify:
DATABASE_URL=postgres://postgres:YOUR_SUPABASE_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres

# 2. Port for Waymesh Axum server
PORT=8080

# 3. Logging verbosity
RUST_LOG=waymesh_server=info,tower_http=info
